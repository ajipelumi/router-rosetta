# Copy to .env.local and fill in. Never commit .env.local.

# MCP endpoint serving the Next.js knowledge base, and its bearer token.
SANITY_CONTEXT_MCP_URL=
SANITY_ORGANIZATION_TOKEN=

# Model providers. Groq is preferred; Google is the fallback.
# At least one is required. Both are read implicitly by their provider.
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
